# Copy to /etc/caddy/pynereal.env, readable only by root and the caddy group.
# Public IPv4 or DNS name only: no scheme, port, path, or private LAN address.
PYNE_HTTPS_HOST=
PYNE_HTTPS_USER=
# Generate interactively with: caddy hash-password
# Paste the complete bcrypt hash literally. Never use the plaintext password.
PYNE_HTTPS_PASSWORD_HASH=
PYNE_HTTP_PORT=9001
